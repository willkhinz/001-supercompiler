(define (len xs) (if (null? xs) 0 (+ 1 (len (cdr xs)))))
(define (append2 xs ys)
  (if (null? xs) ys (cons (car xs) (append2 (cdr xs) ys))))
(define (filterlt p xs)
  (if (null? xs) '()
      (if (< (car xs) p) (cons (car xs) (filterlt p (cdr xs)))
          (filterlt p (cdr xs)))))
(define (filterge p xs)
  (if (null? xs) '()
      (if (>= (car xs) p) (cons (car xs) (filterge p (cdr xs)))
          (filterge p (cdr xs)))))
(define (qsort xs)
  (if (null? xs) '()
      (append2
        (append2 (qsort (filterlt (car xs) (cdr xs))) (cons (car xs) '()))
        (qsort (filterge (car xs) (cdr xs))))))
(len (qsort (list 5 3 8 1 9 2 7 4 6 0 11 13 10 12 14 15 18 16 17 19 23 21 20 22 25 24 27 26 29 28)))
