(define (lookup x env)
  (if (null? env) 0 (if (eq? (car (car env)) x) (car (cdr (car env))) (lookup x (cdr env)))))
(define (ev e env)
  (if (pair? e)
      (let ((op (car e)) (a (car (cdr e))) (b (car (cdr (cdr e)))))
        (if (eq? op '+) (+ (ev a env) (ev b env))
            (if (eq? op '*) (* (ev a env) (ev b env))
                (if (eq? op '-) (- (ev a env) (ev b env)) 0))))
      (if (pair? (assq-val e env)) 0 (lookup e env))))
(define (assq-val k env) '())
